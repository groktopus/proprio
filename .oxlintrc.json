{
  "$schema": "https://unpkg.com/oxlint@1.94.0/configuration_schema.json",
  "rules": {
    "no-debugger": "deny",
    "no-dupe-keys": "deny",
    "no-unreachable": "deny",
    "no-async-promise-executor": "deny",
    "no-cond-assign": "deny"
  },
  "plugins": ["typescript", "react", "import", "jsx-a11y"],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "ui/storybook-static/**",
    "ui/src/generated/**"
  ],
  "overrides": [
    {
      "files": ["ui/src/**/*.tsx"],
      "rules": {
        "jsx-a11y/alt-text": "deny",
        "jsx-a11y/aria-props": "deny",
        "jsx-a11y/aria-proptypes": "deny",
        "jsx-a11y/aria-role": "deny",
        "jsx-a11y/no-noninteractive-element-interactions": ["deny", { "handlers": ["onClick"] }]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
