# Copy to docker/.env. Generate two separate values with openssl rand -hex 32
# and keep the same values across restarts and upgrades.
BETTER_AUTH_SECRET=
PROPRIO_TOOL_ACTION_SIGNING_SECRET=

# Full stack only. Generate a third hex value for PostgreSQL.
PROPRIO_POSTGRES_PASSWORD=

# Uncomment to override defaults. A different port updates the localhost URL.
# PROPRIO_PORT=3200
# PROPRIO_BIND_IP=127.0.0.1
# PROPRIO_PUBLIC_URL=https://proprio.example.com
# PROPRIO_ALLOWED_HOSTNAMES=proprio.example.net
# PROPRIO_DATA_DIR=../data/docker-proprio
