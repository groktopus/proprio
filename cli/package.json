{
  "name": "proprio",
  "version": "0.3.1",
  "description": "Proprio CLI — orchestrate AI agent teams to run a business",
  "type": "module",
  "bin": {
    "proprio": "./dist/index.js"
  },
  "keywords": [
    "proprio",
    "ai",
    "agents",
    "orchestration",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/groktopus/proprio",
    "directory": "cli"
  },
  "homepage": "https://github.com/groktopus/proprio",
  "bugs": {
    "url": "https://github.com/groktopus/proprio/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node --input-type=module -e \"import esbuild from 'esbuild'; import config from './esbuild.config.mjs'; await esbuild.build(config);\" && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@groktopus/adapter-claude-local": "workspace:*",
    "@groktopus/adapter-codex-local": "workspace:*",
    "@groktopus/adapter-cursor-cloud": "workspace:*",
    "@groktopus/adapter-cursor-local": "workspace:*",
    "@groktopus/adapter-gemini-local": "workspace:*",
    "@groktopus/adapter-grok-local": "workspace:*",
    "@groktopus/adapter-kimi-local": "workspace:*",
    "@groktopus/adapter-opencode-local": "workspace:*",
    "@groktopus/adapter-pi-local": "workspace:*",
    "@groktopus/adapter-openclaw-gateway": "workspace:*",
    "@groktopus/adapter-utils": "workspace:*",
    "@groktopus/db": "workspace:*",
    "@groktopus/server": "workspace:*",
    "@groktopus/shared": "workspace:*",
    "@groktopus/hermes-proprio-adapter": "workspace:*",
    "drizzle-orm": "0.45.4",
    "dotenv": "^18.0.10",
    "commander": "^15.1.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
