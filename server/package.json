{
  "name": "@groktopus/server",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/groktopus/proprio",
  "bugs": {
    "url": "https://github.com/groktopus/proprio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/groktopus/proprio",
    "directory": "server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "ui-dist",
    "skills",
    "scripts/install-copilot-assets.mjs"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "cross-env PROPRIO_MIGRATION_PROMPT=never PROPRIO_MIGRATION_AUTO_APPLY=true tsx ./scripts/dev-watch.ts",
    "prepare:ui-dist": "bash ../scripts/prepare-server-ui-dist.sh",
    "build": "pnpm run prepare:runner-vendor && node scripts/verify-runner-vendor-dependencies.mjs && node ../scripts/run-tsc.mjs -p tsconfig.build.json && mkdir -p dist/onboarding-assets dist/built-ins dist/services/scripts dist/vendor/proprio-runner && cp -R src/onboarding-assets/. dist/onboarding-assets/ && cp -R src/built-ins/. dist/built-ins/ && cp -R src/services/scripts/. dist/services/scripts/ && cp -Rf ../packages/proprio-runner/dist/. dist/vendor/proprio-runner/ && cp ../packages/proprio-runner/scripts/install-copilot-assets.mjs ../packages/proprio-runner/scripts/materialize-copilot-binary.mjs ../packages/proprio-runner/scripts/copilot-inner-distribution.mjs dist/ && node dist/install-copilot-assets.mjs && node scripts/write-build-stamp.mjs",
    "prepack": "pnpm run prepare:ui-dist && pnpm run build",
    "postpack": "rm -rf ui-dist",
    "clean": "rm -rf dist",
    "build:runtime": "node scripts/bundle-runtime.mjs",
    "start": "node dist/index.js",
    "prepare:runner-vendor": "node scripts/prepare-runner-vendor.mjs",
    "typecheck": "pnpm --filter @groktopus/proprio-runner run build:typescript && pnpm --filter @groktopus/plugin-sdk ensure-build-deps && node scripts/typecheck-layers.mjs",
    "postinstall": "node scripts/install-copilot-assets.mjs"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@agentclientprotocol/claude-agent-acp": "0.73.0",
