{
  "name": "@groktopus/plugin-fake-sandbox",
  "version": "0.1.0",
  "description": "First-party deterministic fake sandbox provider plugin for Proprio environments",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "proprioPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @groktopus/plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @groktopus/plugin-sdk ensure-build-deps && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@groktopus/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
