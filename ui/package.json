    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "^4.5.0",
    "@groktopus/adapter-claude-local": "workspace:*",
    "@groktopus/adapter-codex-local": "workspace:*",
    "@groktopus/adapter-cursor-cloud": "workspace:*",
    "@groktopus/adapter-cursor-local": "workspace:*",
    "@groktopus/adapter-gemini-local": "workspace:*",
    "@groktopus/adapter-grok-local": "workspace:*",
    "@groktopus/adapter-kimi-local": "workspace:*",
    "@groktopus/adapter-openclaw-gateway": "workspace:*",
    "@groktopus/adapter-opencode-local": "workspace:*",
    "@groktopus/adapter-pi-local": "workspace:*",
    "@groktopus/adapter-utils": "workspace:*",
    "@groktopus/hermes-proprio-adapter": "workspace:*",
    "@groktopus/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.5.0",
    "@spekoai/client": "0.0.15",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.108.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "i18next": "^27.2.2",
    "lexical": "0.53.0",
    "lucide-react": "^1.77.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.3.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
